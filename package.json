{
  "name": "@offthemap/nullisland",
  "version": "0.2.1",
  "description": "ArcGIS layers on Google Maps — PBF vector features, CORS-free image exports, tile-snapped caching. No token needed for public layers.",
  "keywords": [
    "arcgis",
    "esri",
    "google-maps",
    "pbf",
    "protobuf",
    "vector",
    "mapserver",
    "featureserver",
    "gis",
    "maps"
  ],
  "license": "MIT",
  "author": "Joseph <joseph8p@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephcake/nullisland.git"
  },
  "homepage": "https://github.com/josephcake/nullisland#readme",
  "bugs": {
    "url": "https://github.com/josephcake/nullisland/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pbf": {
      "types": "./dist/pbf/index.d.ts",
      "import": "./dist/pbf/index.js",
      "require": "./dist/pbf/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:demo": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --legal-comments=none --outfile=demo/nullisland.js"
  },
  "dependencies": {
    "@types/google.maps": "^3.58.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
